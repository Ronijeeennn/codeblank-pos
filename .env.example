#--------------------------------------------------------------------
# Copy this file to ".env" and edit. ".env" is git-ignored: never commit real credentials.
#--------------------------------------------------------------------

# development shows detailed errors; use "production" on the live server
CI_ENVIRONMENT = development

# Must end with a slash. Local: http://localhost:8080/   Live: https://your-site.example/
app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = tindahan_pos
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

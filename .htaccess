# Shared hosts like InfinityFree always serve from htdocs and can't point the web root at /public.
# These rules send every request into public/ (where the CodeIgniter front controller lives).
# The condition stops requests that are already inside /public/ from being rewritten twice.
# Everything outside public/ (app, vendor, writable, .git, local.php...) becomes unreachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
